# Sao chép file này thành .streamlit/secrets.toml rồi điền giá trị thật.
# File secrets.toml KHÔNG được đưa lên GitHub (đã nằm trong .gitignore).

GROQ_API_KEY = ""
# GROQ_MODEL = "llama-3.3-70b-versatile"   # tùy chọn: đổi model mà không sửa code

# --- Chỉ cần khi DEPLOY. Chạy trên máy cá nhân thì bỏ qua và dùng đăng nhập Google (gcloud). ---
# Dán nội dung file khóa JSON của Service Account (chỉ quyền đọc) vào đây:
# [gcp_service_account]
# type = "service_account"
# project_id = "olist-lakehouse-511407"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "ten-service-account@olist-lakehouse-511407.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
